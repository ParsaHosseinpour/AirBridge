<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AirBridge.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AirBridge.Windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AirBridge">

    <Grid x:Name="RootGrid" RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF04060B" Offset="0" />
                <GradientStop Color="#FF07131F" Offset="0.55" />
                <GradientStop Color="#FF04101A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- atmosphere -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="880" Height="880"
                     Fill="{StaticResource CyanGlowBrush}"
                     Opacity="0.20"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-340,-420,0,0" />
            <Ellipse Width="680" Height="680"
                     Fill="{StaticResource MintGlowBrush}"
                     Opacity="0.10"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-260,-280" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- ================================================== title bar -->
            <Grid Grid.Row="0" Padding="22,0,150,0">
                <Grid x:Name="AppTitleBar" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource LogoGradientBrush}" BorderBrush="#2EFFFFFF" BorderThickness="1">
                            <FontIcon Glyph="&#xE8B5;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="#EAF4FF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AirBridge"
                                   Style="{StaticResource BaseTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Border Style="{StaticResource PillStyle}" Padding="7,2" Margin="2,0,0,0" Background="#125AC8FA" BorderBrush="#2E5AC8FA">
                            <TextBlock Text="WINDOWS"
                                       Style="{StaticResource BaseTextStyle}"
                                       FontSize="8.5"
                                       CharacterSpacing="130"
                                       Foreground="{StaticResource AirBridgeCyanSoftBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ==================================================== header -->
            <Grid Grid.Row="1" Margin="32,10,32,16" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="Send files without the cloud."
                               Style="{StaticResource DisplayTextStyle}"
                               FontSize="32"
                               CharacterSpacing="-16" />
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusColor, Converter={StaticResource HexBrush}}" />
                        <TextBlock Text="{Binding StatusDetail}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   MaxWidth="740" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Style="{StaticResource PillStyle}" Padding="12,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusColor, Converter={StaticResource HexBrush}}" />
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{StaticResource BaseTextStyle}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="RefreshButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnRefreshClick"
                            AutomationProperties.Name="Rescan for nearby devices">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            <TextBlock Text="Rescan" Style="{StaticResource BaseTextStyle}" FontSize="12.5" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Click="OnSettingsClick"
                            ToolTipService.ToolTip="Settings"
                            AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================================================== banner -->
            <InfoBar x:Name="Banner"
                     Grid.Row="2"
                     IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                     Severity="{Binding BannerSeverity}"
                     Message="{Binding BannerText}"
                     IsClosable="True"
                     Margin="32,0,32,12" />

            <!-- =================================================== content -->
            <ScrollViewer x:Name="PageScroll"
                          Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,0,32,22" ColumnSpacing="20" MaxWidth="1440">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.42*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============================================= left -->
                    <StackPanel Grid.Column="0" Spacing="20">
                        <Border Style="{StaticResource RaisedCardStyle}" Padding="20,16,20,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Nearby" Style="{StaticResource TitleTextStyle}" FontSize="18" />
                                        <TextBlock Text="{Binding PeerCountText}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Style="{StaticResource PillStyle}" Padding="10,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="5" Height="5" Fill="{Binding StatusColor, Converter={StaticResource HexBrush}}" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           Style="{StaticResource BaseTextStyle}"
                                                           FontSize="10"
                                                           Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Width="30"
                                                Height="30"
                                                Click="OnRefreshClick"
                                                ToolTipService.ToolTip="Rescan"
                                                AutomationProperties.Name="Rescan for nearby devices">
                                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <controls:PeerRadarView x:Name="Radar"
                                                         Grid.Row="1"
                                                         Height="474"
                                                         Margin="0,2,0,-4"
                                                         ItemsSource="{Binding Peers}"
                                                         Initials="{Binding Initials}"
                                                         DeviceName="{Binding DisplayName}"
                                                         StatusText="Click or drop files"
                                                         IsScanning="{Binding IsScanning}"
                                                         StagedCount="{Binding StagedFiles.Count}"
                                                         PeerInvoked="OnPeerInvoked"
                                                         BrowseRequested="OnBrowseRequested"
                                                         FilesDropped="OnFilesDropped" />

                                <StackPanel Grid.Row="2" Spacing="8" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding Tiers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource PillStyle}"
                                                        Margin="0,0,7,0"
                                                        Padding="9,4"
                                                        ToolTipService.ToolTip="{Binding Tooltip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="{Binding Glyph}"
                                                                  FontFamily="Segoe MDL2 Assets"
                                                                  FontSize="9"
                                                                  Foreground="{Binding StateColor, Converter={StaticResource HexBrush}}" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource BaseTextStyle}"
                                                                   FontSize="9.5"
                                                                   Foreground="{StaticResource AirBridgeMutedBrush}" />
                                                        <TextBlock Text="{Binding StateText}"
                                                                   Style="{StaticResource BaseTextStyle}"
                                                                   FontSize="9.5"
                                                                   Foreground="{Binding StateColor, Converter={StaticResource HexBrush}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ScanNote}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               MaxLines="2" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- device grid -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="18,14,18,14">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="Nearby devices"
                                               Style="{StaticResource BaseTextStyle}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Tap to choose a send target"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <GridView x:Name="PeerGrid"
                                          ItemsSource="{Binding Peers}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="True"
                                          ItemClick="OnPeerGridItemClick"
                                          Height="92"
                                          Padding="0"
                                          Visibility="{Binding HasPeers, Converter={StaticResource BoolToVisibility}}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Enabled"
                                          ScrollViewer.VerticalScrollMode="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="246" ItemHeight="80" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem" BasedOn="{StaticResource PeerGridItemStyle}" />
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10" Background="#0AFFFFFF" CornerRadius="14" Margin="0,0,8,0">
                                                <Border CornerRadius="14"
                                                        BorderBrush="#FF5AC8FA"
                                                        BorderThickness="1.5"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="42" Height="42">
                                                        <Ellipse Width="38" Height="38" Fill="{Binding AvatarBrush}" Stroke="#26FFFFFF" StrokeThickness="1" />
                                                        <FontIcon Glyph="{Binding Glyph}"
                                                                  FontFamily="Segoe MDL2 Assets"
                                                                  FontSize="16"
                                                                  Foreground="#E6FFFFFF"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource BaseTextStyle}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   MaxLines="1" />
                                                        <TextBlock Text="{Binding StatusLine}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   FontSize="9.5"
                                                                   MaxLines="1" />
                                                    </StackPanel>

                                                    <FontIcon Grid.Column="2"
                                                              Glyph="&#xE73E;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="12"
                                                              Foreground="{StaticResource AirBridgeCyanBrush}"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <TextBlock Text="No devices yet. Keep AirBridge open on both devices and use the same Wi-Fi."
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           Visibility="{Binding HasPeers, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================ right -->
                    <StackPanel Grid.Column="1" Spacing="20">
                        <!-- send card -->
                        <Border Style="{StaticResource RaisedCardStyle}" Padding="20,18,20,18">
                            <StackPanel Spacing="13">
                                <Grid>
                                    <TextBlock Text="Send" Style="{StaticResource TitleTextStyle}" FontSize="18" />
                                    <TextBlock Text="{Binding PeerIdText}"
                                               Style="{StaticResource MonoIdTextStyle}"
                                               FontSize="9"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Border Background="#0BFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="16" Padding="12">
                                    <Grid ColumnSpacing="11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="48" Height="48">
                                            <Ellipse Width="44" Height="44" Fill="{Binding SelectedPeer.AvatarBrush}" Stroke="#22FFFFFF" StrokeThickness="1" />
                                            <FontIcon Glyph="{Binding SelectedPeer.Glyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="17"
                                                      Foreground="#E6FFFFFF"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE8B5;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="15"
                                                      Foreground="#8C9FE7FF"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding HasSelectedPeer, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding SelectedPeerName}"
                                                       Style="{StaticResource BaseTextStyle}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       MaxLines="1" />
                                            <TextBlock Text="{Binding SelectedPeerDetail}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="10.5"
                                                       MaxLines="1" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <TextBlock Text="Files to send"
                                               Style="{StaticResource BaseTextStyle}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AirBridgeMutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StagedSummaryText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   FontSize="9.5"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Clear"
                                                Style="{StaticResource GhostButtonStyle}"
                                                FontSize="9.5"
                                                Padding="6,2"
                                                Click="OnClearFilesClick"
                                                Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer MaxHeight="132"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding StagedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,6" Margin="0,0,0,4" Background="#08FFFFFF" CornerRadius="10" ColumnSpacing="9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon Glyph="{Binding Glyph}"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="13"
                                                              Foreground="{StaticResource AirBridgeCyanSoftBrush}"
                                                              VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource BaseTextStyle}"
                                                                   FontSize="11"
                                                                   MaxLines="1" />
                                                        <TextBlock Text="{Binding Folder}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   FontSize="8.5"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding Folder, Converter={StaticResource StringToVisibility}}" />
                                                        <TextBlock Text="{Binding SizeText}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   FontSize="9" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="26"
                                                            Height="26"
                                                            Click="OnRemoveFileClick"
                                                            ToolTipService.ToolTip="Remove from list"
                                                            AutomationProperties.Name="Remove file">
                                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Background="#08FFFFFF"
                                        CornerRadius="12"
                                        Padding="12,14"
                                        Visibility="{Binding HasStagedFiles, Converter={StaticResource InverseBoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AirBridgeCyanSoftBrush}" />
                                        <TextBlock Text="Drop files or folders on the radar, or choose them below."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding SendButtonText}"
                                        IsEnabled="{Binding CanSend}"
                                        Click="OnSendClick"
                                        HorizontalAlignment="Stretch" />

                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnBrowseClick"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                        <TextBlock Text="Choose files" Style="{StaticResource BaseTextStyle}" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnBrowseFolderClick"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                        <TextBlock Text="Choose folder" Style="{StaticResource BaseTextStyle}" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnVerifyPeerClick"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding CanVerifySelectedPeer, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                        <TextBlock Text="Verify device again" Style="{StaticResource BaseTextStyle}" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnForgetPeerClick"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding CanForgetSelectedPeer, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE74D;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12"
                                                  Foreground="{StaticResource AirBridgeDangerBrush}" />
                                        <TextBlock Text="Forget this device"
                                                   Style="{StaticResource BaseTextStyle}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AirBridgeDangerBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- transfers -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="18,16,18,14">
                            <StackPanel Spacing="11">
                                <Grid>
                                    <TextBlock Text="{Binding TransferHeaderText}" Style="{StaticResource TitleTextStyle}" FontSize="16" />
                                    <Button Content="Clear finished"
                                            Style="{StaticResource GhostButtonStyle}"
                                            FontSize="10"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            Click="OnClearFinishedClick"
                                            Visibility="{Binding HasTransfers, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <TextBlock Text="No transfers yet. Drop a file to begin."
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="11"
                                           Visibility="{Binding HasTransfers, Converter={StaticResource InverseBoolToVisibility}}" />

                                <ScrollViewer x:Name="TransfersScrollViewer"
                                              MaxHeight="330"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Transfers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#08FFFFFF"
                                                        BorderBrush="#10FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="15"
                                                        Padding="12"
                                                        Margin="0,0,0,8">
                                                    <Grid ColumnSpacing="11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Width="46" Height="46">
                                                            <ProgressRing Width="44"
                                                                          Height="44"
                                                                          Minimum="0"
                                                                          Maximum="100"
                                                                          Value="{Binding Progress}"
                                                                          IsIndeterminate="{Binding RingIsIndeterminate}"
                                                                          Foreground="{Binding ProgressColor, Converter={StaticResource HexBrush}}"
                                                                          Visibility="{Binding RingIsIndeterminate, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <ProgressRing Width="44"
                                                                          Height="44"
                                                                          IsIndeterminate="True"
                                                                          Foreground="{Binding ProgressColor, Converter={StaticResource HexBrush}}"
                                                                          Visibility="{Binding RingIsIndeterminate, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="{Binding PercentText}"
                                                                       Style="{StaticResource BaseTextStyle}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>

                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       Style="{StaticResource BaseTextStyle}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       MaxLines="1" />
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       FontSize="9.5"
                                                                       MaxLines="1" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Header}"
                                                                           Style="{StaticResource MutedTextStyle}"
                                                                           FontSize="8.5"
                                                                           Foreground="#7A9DB2C4" />
                                                                <TextBlock Text="{Binding SizeText}"
                                                                           Style="{StaticResource MutedTextStyle}"
                                                                           FontSize="8.5" />
                                                                <TextBlock Text="{Binding RemainingText}"
                                                                           Style="{StaticResource MutedTextStyle}"
                                                                           FontSize="8.5"
                                                                           Visibility="{Binding RemainingText, Converter={StaticResource StringToVisibility}}" />
                                                                <TextBlock Text="{Binding EtaText}"
                                                                           Style="{StaticResource MutedTextStyle}"
                                                                           FontSize="8.5"
                                                                           Foreground="{StaticResource AirBridgeCyanSoftBrush}"
                                                                           Visibility="{Binding EtaText, Converter={StaticResource StringToVisibility}}" />
                                                            </StackPanel>

                                                            <ScrollViewer MaxHeight="108"
                                                                          Margin="0,4,0,0"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          Visibility="{Binding HasFileList, Converter={StaticResource BoolToVisibility}}">
                                                                <ItemsControl ItemsSource="{Binding Files}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid ColumnSpacing="6" Margin="0,1">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <FontIcon Glyph="{Binding Glyph}"
                                                                                          FontFamily="Segoe MDL2 Assets"
                                                                                          FontSize="9"
                                                                                          Foreground="{StaticResource AirBridgeCyanSoftBrush}"
                                                                                          VerticalAlignment="Center" />

                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding Name}"
                                                                                           Style="{StaticResource BaseTextStyle}"
                                                                                           FontSize="9"
                                                                                           MaxLines="1"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           ToolTipService.ToolTip="{Binding RelativePath}" />

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding StatusText}"
                                                                                           FontSize="8.5"
                                                                                           MaxWidth="110"
                                                                                           MaxLines="1"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource IconButtonStyle}"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Click="OnCancelTransferClick"
                                                                    ToolTipService.ToolTip="Cancel transfer"
                                                                    AutomationProperties.Name="Cancel transfer"
                                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}">
                                                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButtonStyle}"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Click="OnRevealTransferClick"
                                                                    ToolTipService.ToolTip="Show in folder"
                                                                    AutomationProperties.Name="Show transfer in folder"
                                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                                                <FontIcon Glyph="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButtonStyle}"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Click="OnDismissTransferClick"
                                                                    ToolTipService.ToolTip="Remove from list"
                                                                    AutomationProperties.Name="Dismiss transfer"
                                                                    Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}">
                                                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- sharing and firewall -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="18,16,18,16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Sharing" Style="{StaticResource TitleTextStyle}" FontSize="16" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Incoming files"
                                                   Style="{StaticResource BaseTextStyle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding ReceiverStatusText}"
                                                       Style="{StaticResource BaseTextStyle}"
                                                       FontSize="9.5"
                                                       Foreground="{Binding ReceiverStatusColor, Converter={StaticResource HexBrush}}" />
                                            <TextBlock Text="{Binding ListenPortText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="9.5" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{Binding ReceiverEnabled, Mode=TwoWay}"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding FirewallStatusColor, Converter={StaticResource HexBrush}}"
                                             VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Windows Firewall"
                                                   Style="{StaticResource BaseTextStyle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FirewallStatusText}"
                                                   Style="{StaticResource BaseTextStyle}"
                                                   FontSize="9.5"
                                                   Foreground="{Binding FirewallStatusColor, Converter={StaticResource HexBrush}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <Button Content="Set up"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="10"
                                                Padding="10,5"
                                                Click="OnSetupFirewallClick"
                                                Visibility="{Binding FirewallIsReady, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Width="28"
                                                Height="28"
                                                Click="OnRefreshFirewallClick"
                                                ToolTipService.ToolTip="Check firewall again"
                                                AutomationProperties.Name="Check firewall again">
                                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OnOpenDownloadsClick"
                                            HorizontalAlignment="Stretch"
                                            FontSize="10.5"
                                            Padding="10,7">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                            <TextBlock Text="Downloads" Style="{StaticResource BaseTextStyle}" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OnOpenLogsClick"
                                            HorizontalAlignment="Stretch"
                                            FontSize="10.5"
                                            Padding="10,7">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                            <TextBlock Text="Logs" Style="{StaticResource BaseTextStyle}" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ==================================================== footer -->
            <Grid Grid.Row="4" Margin="32,0,32,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5"
                             Fill="{StaticResource AirBridgeMintBrush}"
                             Visibility="{Binding NativeReady, Converter={StaticResource BoolToVisibility}}" />
                    <Ellipse Width="5" Height="5"
                             Fill="{StaticResource AirBridgeDangerBrush}"
                             Visibility="{Binding NativeReady, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding NativeStatusText}"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="9"
                               MaxLines="1" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeerIdText}"
                               Style="{StaticResource MonoIdTextStyle}"
                               FontSize="8"
                               ToolTipService.ToolTip="This device's peer ID" />
                    <TextBlock Text="v"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="9" />
                    <TextBlock Text="{Binding AppVersion}"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="9" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
