<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AirBridge.Windows.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{StaticResource AirBridgeDialogStyle}"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="560" Padding="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="440" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="THIS DEVICE" Style="{StaticResource SectionTextStyle}" />
                <TextBlock Text="Device name" Style="{StaticResource BaseTextStyle}" FontSize="12.5" FontWeight="SemiBold" />
                <TextBox x:Name="DisplayNameBox"
                         MaxLength="48"
                         PlaceholderText="Name shown to nearby devices" />
                <TextBlock Text="Shown in other devices' radar. Use something you recognise."
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Transfer port" Style="{StaticResource BaseTextStyle}" FontSize="12.5" FontWeight="SemiBold" />
                <NumberBox x:Name="PortBox"
                           Minimum="1024"
                           Maximum="65535"
                           SmallChange="1"
                           LargeChange="100"
                           SpinButtonPlacementMode="Compact"
                           HorizontalAlignment="Stretch" />
                <TextBlock Text="TCP port used by the sender and the incoming listener. A firewall rule opens this port on private networks."
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Download folder" Style="{StaticResource BaseTextStyle}" FontSize="12.5" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DownloadBox" PlaceholderText="Folder for received files" />
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Click="OnBrowseFolder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Stretch" />
                </Grid>
            </StackPanel>

            <ToggleSwitch x:Name="ReceiveToggle"
                          Header="Accept incoming files"
                          OnContent="On"
                          OffContent="Off" />

            <ToggleSwitch x:Name="AutoScanToggle"
                          Header="Scan for devices on launch"
                          OnContent="On"
                          OffContent="Off" />

            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,2" />

            <StackPanel Spacing="4">
                <TextBlock Text="DISCOVERY" Style="{StaticResource SectionTextStyle}" Margin="0,0,0,4" />
                <ToggleSwitch x:Name="BleToggle"
                              Header="Bluetooth LE"
                              OnContent="On"
                              OffContent="Off" />
                <ToggleSwitch x:Name="MdnsToggle"
                              Header="Wi-Fi / mDNS"
                              OnContent="On"
                              OffContent="Off" />
                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="Subnet sweep" Style="{StaticResource BaseTextStyle}" FontSize="12.5" FontWeight="SemiBold" />
                    <ComboBox x:Name="SubnetBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Only when mDNS finds nothing" />
                        <ComboBoxItem Content="Always" />
                    </ComboBox>
                    <TextBlock Text="The sweep probes the local subnet directly. It is the most reliable fallback when routers block multicast."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,2" />

            <StackPanel Spacing="4">
                <TextBlock Text="DATA" Style="{StaticResource SectionTextStyle}" Margin="0,0,0,4" />
                <TextBlock x:Name="StorageNoteText"
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
                <TextBlock x:Name="PeerIdNoteText"
                           Style="{StaticResource MonoIdTextStyle}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource AirBridgeDangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
