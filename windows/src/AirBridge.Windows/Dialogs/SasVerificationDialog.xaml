<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AirBridge.Windows.Dialogs.SasVerificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{StaticResource AirBridgeDialogStyle}"
    Title="Verify device"
    PrimaryButtonText="Codes match"
    CloseButtonText="Cancel"
    DefaultButton="None">

    <Grid Width="420">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="54" Height="54">
                    <Ellipse Width="50"
                             Height="50"
                             Fill="#1A5AC8FA"
                             Stroke="#2EFFFFFF"
                             StrokeThickness="1.5" />
                    <FontIcon x:Name="PeerGlyph"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="#E6FFFFFF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="PeerNameText"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="17"
                               MaxLines="1" />
                    <TextBlock x:Name="PeerDetailText"
                               Style="{StaticResource MutedTextStyle}"
                               MaxLines="1" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="InstructionText"
                       Text="Compare this code with the other device. Both screens must show the same six digits."
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource AirBridgeMutedBrush}"
                       FontSize="12.5"
                       TextWrapping="Wrap" />

            <Border Background="#FF0A1522"
                    BorderBrush="#335AC8FA"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CodeText"
                               Text="000 000"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AirBridgeCyanSoftBrush}"
                               CharacterSpacing="240"
                               TextAlignment="Center"
                               IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ExpiryText"
                               Text="Expires in 2:00"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="10.5"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Background="#14000000"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="IDENTITY KEY FINGERPRINT"
                               Style="{StaticResource BaseTextStyle}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AirBridgeMutedBrush}"
                               CharacterSpacing="80" />
                    <TextBlock x:Name="FingerprintText"
                               Text="—"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10.5"
                               Foreground="#D9EAF4FF"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
                       Text="The code proves the encrypted session. Approving also remembers this device's key fingerprint, which is checked on every later transfer."
                       Style="{StaticResource BaseTextStyle}"
                       FontSize="11"
                       Foreground="{StaticResource AirBridgeMutedBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="None" />
        </StackPanel>
    </Grid>
</ContentDialog>
